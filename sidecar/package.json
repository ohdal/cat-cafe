{
  "name": "@cat-cafe/steam-sidecar",
  "private": true,
  "version": "0.1.0",
  "description": "Node sidecar hosting steam-user for the cat-cafe Tauri app (runs outside the webview)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/index.cjs",
  "bin": "dist/index.cjs",
  "pkg": {
    "assets": [
      "dist/system.pem"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs",
    "package": "pnpm run bundle && node scripts/package-binary.mjs",
    "dev": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "steam-user": "^5.3.0",
    "steamid": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@yao-pkg/pkg": "^6.9.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
  }
}
